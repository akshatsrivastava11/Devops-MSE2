{
  "name": "burnroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --ignore ./app --ignore ./components server/index.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "ioredis": "^5.4.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=22" }
}
